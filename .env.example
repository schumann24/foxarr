# Foxarr configuration. Copy to .env and adjust as needed.
# Never commit real credentials.

FOXARR_DATABASE=/data/foxarr.db
FOXARR_ROOT_FOLDER=/movies
FOXARR_QUALITY_PROFILE_ID=1
FOXARR_QUALITY_PROFILE_NAME=Any <= 8 GB, 5+ seeders
FOXARR_DRY_RUN=true
FOXARR_PROWLARR_URL=http://prowlarr:9696
# FOXARR_PROWLARR_API_KEY=
FOXARR_TRANSMISSION_MOVIE_DIR=/home/blackfox/data/film
FOXARR_TRANSMISSION_SERIES_DIR=/home/blackfox/data/serial
# Optional JSON map of Radarr-compatible profile ids to Foxarr release rules.
# Hard filters reject a release; preferred values only affect ranking.
FOXARR_SELECTION_PROFILES_JSON={"1":{"name":"Any <= 8 GB, 5+ seeders","criteria":{"maxSize":8000000000,"minSeeders":5}}}
# Optional. Seerr can send this value as `apikey` or `X-Api-Key`.
# FOXARR_API_KEY=

# Prowlarr/Transmission integrations are intentionally limited to the
# explicit dry-run search endpoint in the current MVP.
# Transmission is intentionally not configured in this stage.
