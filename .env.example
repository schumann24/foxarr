# Foxarr configuration. Copy to .env and adjust as needed.
# Never commit real credentials.

FOXARR_DATABASE=/data/foxarr.db
FOXARR_ROOT_FOLDER=/movies
FOXARR_QUALITY_PROFILE_ID=1
FOXARR_QUALITY_PROFILE_NAME=Any
# Optional. Seerr can send this value as `apikey` or `X-Api-Key`.
# FOXARR_API_KEY=

# PROWLARR_URL=https://prowlarr.example.com
# PROWLARR_API_KEY=
# TRANSMISSION_URL=http://transmission.example.com:9091/transmission/rpc
# TRANSMISSION_USERNAME=
# TRANSMISSION_PASSWORD=
# The integrations below are intentionally not implemented in the movie MVP.
# PROWLARR_URL=https://prowlarr.example.com
# PROWLARR_API_KEY=
# TRANSMISSION_URL=http://transmission.example.com:9091/transmission/rpc
# TRANSMISSION_USERNAME=
# TRANSMISSION_PASSWORD=
# DRY_RUN=true
